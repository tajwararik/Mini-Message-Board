<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <h1><%= title %></h1>

    <% if (locals.error) {%>
    <p class="error-msg"><%= error %></p>
    <% } %>

    <% if(locals.messages.length === 0 && !locals.error) { %>
    <p>No message available.</p>
    <% } else { %>
    <% messages.forEach((message) => { %>
    <p>Username: <%= message.username %></p>
    <p>Message: <%= message.message %></p>
    <p>Date: <%= message.added %></p>
    <a href="/message/<%= message.username %>">Open</a>
    <hr />
    <% }) %>
    <% } %>

    <a href="/new">Create new message</a>
  </body>
</html>

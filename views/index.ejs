<!DOCTYPE html>
<html>
  <head>
    <title><%= locals.title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main>
      <h1><%= locals.title %></h1>

      <% if (locals.error) {%>
      <p class="error-msg"><%= error %></p>
      <% } %>

      <div class="display-message">
        <% if(locals.messages.length === 0 && !locals.error) { %>
        <p>No message available.</p>
        <% } else { %>
        <% locals.messages.forEach((message) => { %>
        <p>
          <strong>Username:</strong>
          <%= message.username %>
        </p>
        <p>
          <strong>Message:</strong>
          <%= message.message %>
        </p>
        <p>
          <strong>Date:</strong>
          <%= message.added %>
        </p>
        <p class="view">
          All messages of <%= message.username %>
          <a href="/message/<%= message.username %>">View</a>
        </p>
        <hr />
        <% }) %>
        <% } %>
      </div>

      <a href="/new">Create new message</a>
    </main>
  </body>
</html>

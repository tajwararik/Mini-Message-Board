<!DOCTYPE html>
<html>
  <head>
    <title><%= locals.title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main>
      <h1>Message Details</h1>

      <% if (locals.error) {%>
      <p class="error-msg"><%= locals.error %></p>
      <% } %>

      <% if(!locals.error) { %>
      <p>
        <strong>Username:</strong>
        <%= locals.username %>
      </p>

      <% locals.messages.forEach(message => { %>
      <ul>
        <li>
          <strong> Message:</strong>
          <%= message.message %>
        </li>
        <li>
          <strong> Date: </strong>
          <%= message.added %>
        </li>
      </ul>
      <% }) %>
      <% } %>

      <a href="/">Back</a>
    </main>
  </body>
</html>

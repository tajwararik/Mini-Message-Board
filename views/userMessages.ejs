<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <h1>Message Details</h1>

    <% if (locals.error) {%>
    <p class="error-msg"><%= error %></p>
    <% } %>

    <% if(!locals.error) { %>
    <p>
      <strong>Username:</strong>
      <%= username %>
    </p>

    <% messages.forEach(message => { %>
    <ul>
      <li>
        Message:
        <%= message.message %>
      </li>
      <li>
        Date:
        <%= message.added %>
      </li>
    </ul>
    <% }) %>
    <% } %>

    <a href="/">Back</a>
  </body>
</html>
